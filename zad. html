<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>زاد | ZAD</title>

  <!-- Tailwind via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: { navy: '#0A192F', gold: '#FFD700' },
          fontFamily: { sans: ['Tajawal', 'system-ui', 'sans-serif'] }
        }
      }
    }
  </script>

  <!-- Arabic font -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet" />

  <style>
    body { font-family: 'Tajawal', system-ui, sans-serif; }
    .safe-top { padding-top: env(safe-area-inset-top, 0px); }
    .safe-bottom { padding-bottom: env(safe-area-inset-bottom, 0px); }
  </style>
</head>

<body class="bg-slate-100 text-navy">
  <div class="mx-auto min-h-screen max-w-md bg-slate-50 shadow-xl">

    <!-- ========== Navbar ========== -->
    <header class="sticky top-0 z-20 bg-navy safe-top">
      <div class="flex items-center justify-between px-4 py-3">
        <!-- Logo -->
        <a href="#" class="flex items-center gap-2" aria-label="زاد">
          <svg viewBox="0 0 24 24" class="h-8 w-8 text-gold" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 6c-2-1.5-5-2-9-2v14c4 0 7 .5 9 2 2-1.5 5-2 9-2V4c-4 0-7 .5-9 2z"/>
            <path d="M12 6v14"/>
          </svg>
          <span class="text-2xl font-extrabold leading-none text-gold">زاد</span>
          <span class="text-xs font-bold tracking-widest text-white/70">ZAD</span>
        </a>

        <!-- User -->
        <a href="#" class="flex items-center gap-2 rounded-full bg-white/10 py-1 pe-3 ps-1">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gold text-sm font-extrabold text-navy">ط</span>
          <span class="text-sm font-medium text-white">الطاهر</span>
        </a>
      </div>
    </header>

    <main class="px-4 pb-28 pt-4">

      <!-- ========== Hero ========== -->
      <section class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy via-[#12305a] to-[#1b4b8f] p-6 text-white">
        <div class="absolute -left-10 -top-10 h-40 w-40 rounded-full bg-gold/10" aria-hidden="true"></div>
        <div class="absolute -bottom-12 left-16 h-32 w-32 rounded-full bg-white/5" aria-hidden="true"></div>
        <div class="relative">
          <p class="text-sm text-white/70">أهلاً بعودتك</p>
          <h1 class="mt-1 text-3xl font-extrabold leading-tight">
            مرحباً يا <span class="text-gold">الطاهر</span>
          </h1>
          <p class="mt-3 max-w-[16rem] text-sm leading-relaxed text-white/80">
            زادك في العلم، زادك في الحياة. اختر مجالاً وأكمل رحلتك من حيث توقفت.
          </p>
          <a href="#domains" class="mt-5 inline-block rounded-full bg-gold px-5 py-2 text-sm font-bold text-navy active:scale-95">
            ابدأ التعلم
          </a>
        </div>
      </section>

      <!-- ========== Domains ========== -->
      <section id="domains" class="mt-6">
        <h2 class="mb-3 text-lg font-extrabold">مجالات زاد</h2>

        <div class="grid grid-cols-2 gap-3">

          <!-- Programming -->
          <a href="#" class="group flex flex-col rounded-2xl bg-gradient-to-br from-sky-50 to-blue-200 p-4 ring-1 ring-blue-200 active:scale-[0.98]">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-blue-700 shadow-sm">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/></svg>
            </span>
            <span class="mt-3 text-lg font-extrabold text-blue-900">البرمجة</span>
            <span class="mt-0.5 text-xs text-blue-900/70">اكتب .. طور .. ابتكر</span>
          </a>

          <!-- English -->
          <a href="#" class="group flex flex-col rounded-2xl bg-gradient-to-br from-purple-50 to-purple-200 p-4 ring-1 ring-purple-200 active:scale-[0.98]">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-purple-700 shadow-sm">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg>
            </span>
            <span class="mt-3 text-lg font-extrabold text-purple-900">اللغة الإنجليزية</span>
            <span class="mt-0.5 text-xs text-purple-900/70">تعلّم .. تواصل .. تطور</span>
          </a>

          <!-- University -->
          <a href="#" class="group flex flex-col rounded-2xl bg-gradient-to-br from-amber-50 to-amber-200 p-4 ring-1 ring-amber-200 active:scale-[0.98]">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-amber-700 shadow-sm">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9l10-5 10 5-10 5z"/><path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5"/></svg>
            </span>
            <span class="mt-3 text-lg font-extrabold text-amber-900">المقررات الجامعية</span>
            <span class="mt-0.5 text-xs text-amber-900/70">نظّم دراستك .. حقق أهدافك</span>
          </a>

          <!-- Islamic -->
          <a href="#" class="group flex flex-col rounded-2xl bg-gradient-to-br from-emerald-50 to-emerald-200 p-4 ring-1 ring-emerald-200 active:scale-[0.98]">
            <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-white text-emerald-700 shadow-sm">
              <svg viewBox="0 0 24 24" class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
            </span>
            <span class="mt-3 text-lg font-extrabold text-emerald-900">التعليم الإسلامي</span>
            <span class="mt-0.5 text-xs text-emerald-900/70">تعلّم دينك .. وارتق بأخلاقك</span>
          </a>

        </div>
      </section>
    </main>

    <!-- ========== Bottom Navigation ========== -->
    <nav class="fixed bottom-0 left-1/2 z-30 w-full max-w-md -translate-x-1/2 rounded-t-3xl bg-navy safe-bottom" aria-label="التنقل الرئيسي">
      <ul class="grid grid-cols-4 px-2 pt-2">

        <li>
          <a href="#" aria-current="page" class="flex flex-col items-center gap-1 py-2 text-gold">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
            <span class="text-xs font-bold">الرئيسية</span>
          </a>
        </li>

        <li>
          <a href="#" class="flex flex-col items-center gap-1 py-2 text-white/70">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            <span class="text-xs font-medium">المجالات</span>
          </a>
        </li>

        <li>
          <a href="#" class="relative flex flex-col items-center gap-1 py-2 text-white/70">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <span class="absolute right-1/2 top-1 -mr-[-0.4rem] flex h-4 min-w-4 items-center justify-center rounded-full bg-red-500 px-1 text-[10px] font-bold text-white">3</span>
            <span class="text-xs font-medium">الإشعارات</span>
          </a>
        </li>

        <li>
          <a href="#" class="flex flex-col items-center gap-1 py-2 text-white/70">
            <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
            <span class="text-xs font-medium">حسابي</span>
          </a>
        </li>

      </ul>
    </nav>

  </div>
</body>
</html>
